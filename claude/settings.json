{
  "env": {
    "PR_REVIEW_OWNERS": "r0jjames",
    "PR_REVIEW_COPILOT": "0"
  },
  "permissions": {
    "allow": [
      "Bash(gh repo edit:*)"
    ],
    "defaultMode": "auto"
  },
  "skillOverrides": {
    "architecture-blueprint-generator": "off",
    "add-educational-comments": "off",
    "context-map": "off",
    "acquire-codebase-knowledge": "user-invocable-only",
    "code-review-pr": "user-invocable-only",
    "code-review-pr-fast": "user-invocable-only",
    "review-pr-comment": "user-invocable-only",
    "code-tour": "user-invocable-only",
    "explain-logic": "user-invocable-only",
    "investigate-issue": "user-invocable-only",
    "soundboarding": "user-invocable-only",
    "tour-codebase": "user-invocable-only",
    "create-implement-sb": "user-invocable-only",
    "create-sb": "user-invocable-only",
    "explain-and-review": "user-invocable-only",
    "explain-code": "user-invocable-only",
    "implement-sb": "user-invocable-only",
    "anthropic-skills:built-in-browser": "user-invocable-only",
    "anthropic-skills:chrome-browser": "user-invocable-only",
    "anthropic-skills:computer-use": "user-invocable-only",
    "anthropic-skills:deep-research": "user-invocable-only",
    "anthropic-skills:docs": "user-invocable-only",
    "anthropic-skills:docx": "user-invocable-only",
    "anthropic-skills:import-memory": "user-invocable-only",
    "anthropic-skills:learn": "user-invocable-only",
    "anthropic-skills:mcp-builder": "user-invocable-only",
    "anthropic-skills:morning": "user-invocable-only",
    "anthropic-skills:pptx": "user-invocable-only",
    "anthropic-skills:skill-creator": "user-invocable-only",
    "anthropic-skills:xlsx": "user-invocable-only"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/pr_review_hook.py\" || true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh \"$HOME/.claude/statusline-command.sh\""
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "vercel@claude-plugins-official": false,
    "caveman@caveman": false,
    "supabase@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "data@synced": false,
    "engineering@synced": false,
    "product-management@synced": false,
    "productivity@synced": false,
    "cowork-plugin-management@synced": false,
    "pdf-viewer@synced": false
  },
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      },
      "autoUpdate": true
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      },
      "autoUpdate": true
    }
  },
  "effortLevel": "high",
  "theme": "dark",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Not configured**: organization, cloud provider(s), secrets management, CI/CD deploy targets, network posture, trusted internal domains, trusted cloud buckets, key internal services, internal package registry, data retention / declassification, org-specific CLIs",
      "**Repository visibility**: not queryable here — assume private (default fallback; no signal indicates public)",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Default / protected branches**: main (default branch); protection status not queryable here",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material shared only with audiences cleared at the [named+specifics] bar",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Git identity**: commits and PRs in every repository use Roj's git identity only — never add Claude as author, co-author, or trailer"
    ]
  }
}
