# Ghostty config — theme + font reused from the iTerm2 dynamic profile
# (iterm2/com.dotfiles.json). Tango palette on a custom purple background.
# Keymaps are intentionally omitted: set them per-environment (e.g. Citrix VDI).

# ---- Colors ----
background = 300a24
foreground = eeeeec
cursor-color = bbbbbb
cursor-text = 300a24
selection-background = b5d5ff
selection-foreground = 300a24

palette = 0=#2e3436
palette = 1=#cc0000
palette = 2=#4e9a06
palette = 3=#c4a000
palette = 4=#3465a4
palette = 5=#75507b
palette = 6=#06989a
palette = 7=#d3d7cf
palette = 8=#555753
palette = 9=#ef2929
palette = 10=#8ae234
palette = 11=#fce94f
palette = 12=#729fcf
palette = 13=#ad7fa8
palette = 14=#34e2e2
palette = 15=#eeeeec

# Pin bold text to the bright ANSI slots, matching iTerm2's "Use Bright
# Bold". This is Ghostty's default as of 1.3.1; set explicitly so the two
# profiles stay in sync if that default ever changes.
bold-is-bright = true

# Tango was drawn for a near-black background; on this purple the darkest
# slots (0, 8, 5, 4, 1) fall under 3:1. Lift them at render time instead of
# editing the palette, so the colors stay in sync with the iTerm2 profile.
minimum-contrast = 3

# ---- Font (same cask as iTerm2: font-meslo-lg-nerd-font) ----
font-family = MesloLGS Nerd Font Mono
font-size = 13

# ---- Sane defaults ----
window-padding-x = 8
window-padding-y = 8
cursor-style = block
copy-on-select = false
macos-titlebar-style = tabs
